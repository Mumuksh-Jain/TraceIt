# ==============================================================================
# TraceIt Node.js Backend - Environment Variables Template
#
# IMPORTANT SECURITY NOTICE:
# - These secrets must NEVER be committed to Git or exposed to the frontend!
# - Keep this file strictly on the server or in your secure cloud hosting provider.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/TraceIt

# AI Python Microservice Endpoint (HTTPS)
PYTHON_API_URL=https://traceit-czvo.onrender.com/match

# Authentication Secret Key (Random 64+ char hex/base64 string in production)
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
