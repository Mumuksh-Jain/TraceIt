# ==============================================================================
# TraceIt Frontend - Environment Variables Template
#
# IMPORTANT SECURITY NOTICE:
# - NEVER put secrets, private keys, database credentials, or API tokens in this file!
# - All variables starting with VITE_ are embedded into the client-side JavaScript bundle
#   and can be read by ANY user or web crawler visiting the website.
# - Only public URLs and public analytics measurement IDs belong here.
# ==============================================================================

# Public API URL (Points to the backend service over HTTPS)
VITE_API_URL=https://traceit-node.onrender.com/api

# Optional: Google Analytics 4 Measurement ID (Safe for client-side use)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
